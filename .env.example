# Application
PORT=3000

# Supabase (Cloud PostgreSQL)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Backend will use these for direct DB connection (from Supabase Connection Pooler)
SQL_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SQL_PORT=5432
SQL_USER=postgres.your_project_ref
SQL_PASSWORD=your_postgres_password_here
SQL_DB_NAME=postgres
